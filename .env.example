# ──────────────────────────────────────────────────────────────
# Cloud File Sync — environment variables
# Copy to `.env` and fill in real values for local dev.
# ──────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-use-a-50-char-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
POSTGRES_DB=cloudfilesync
POSTGRES_USER=cloudfilesync
POSTGRES_PASSWORD=cloudfilesync
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://cloudfilesync:cloudfilesync@db:5432/cloudfilesync

# ── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── File / storage limits ─────────────────────────────────────
MAX_FILE_SIZE_BYTES=104857600              # 100 MB
USER_STORAGE_QUOTA_BYTES=1073741824        # 1 GB
SIGNED_URL_TTL_SECONDS=300

# ── Backblaze B2 (S3-compatible API) ──────────────────────────
B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=cloud-file-sync-dev
B2_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
